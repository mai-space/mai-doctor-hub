<?xml version="1.0" encoding="utf-8"?>
<!-- Nächster Termin, eine Zeile hoch (2×1 bis 4×1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_padding"
    android:paddingEnd="@dimen/widget_padding">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_chip_bg"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_widget_calendar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/widget_appointment_title"
            android:textColor="@color/widget_on_bg"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_appointment_generic"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_chip_bg"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:textColor="@color/widget_on_chip"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
