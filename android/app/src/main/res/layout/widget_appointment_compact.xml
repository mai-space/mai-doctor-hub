<?xml version="1.0" encoding="utf-8"?>
<!-- Nächster Termin, klein (1×1): Tag und Uhrzeit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:text="@string/widget_tomorrow"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="@string/widget_sample_time"
        android:textColor="@color/widget_on_bg"
        android:textSize="20sp" />
</LinearLayout>
